{
  "name": "physio-clinic-api",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js API for the physiotherapy clinic website: Meta (Facebook/Instagram) Ads integration, admin auth and appointment enquiries.",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "hash-password": "tsx src/scripts/hash-password.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
